# Prize Bond Monitor BD - environment configuration
# Copy to .env and fill in. NEVER commit .env.

APP_ENV=production            # production | local | testing
APP_URL=https://example.com   # public base URL, no trailing slash
APP_BASE_PATH=                # sub-directory install, e.g. /prizebond/public (leave empty if document root is public/)
APP_KEY=                      # random 32+ char secret (php -r "echo bin2hex(random_bytes(32));")

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=prizebond
DB_USERNAME=prizebond
DB_PASSWORD=

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls           # tls | ssl | none
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="Prize Bond Monitor BD"
MAIL_TRANSPORT=smtp           # smtp | log (log writes mails to storage/logs - for local testing only)

# Source fetching (SSRF protection: only these hosts may be fetched)
SOURCE_ALLOWED_HOSTS=www.bb.org.bd,bb.org.bd,prizebond.ird.gov.bd,nationalsavings.gov.bd
HTTP_TIMEOUT=30
HTTP_CONNECT_TIMEOUT=10
HTTP_RETRIES=3
HTTP_USER_AGENT="PrizeBondMonitorBD/1.0 (+result monitoring; contact: set-your-contact-url)"

# Backups
MYSQLDUMP_PATH=mysqldump
BACKUP_DIR=storage/backups
