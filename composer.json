{
    "name": "prizebond/monitor-bd",
    "description": "Prize Bond Monitor BD - Bangladesh prize bond result monitoring, matching and email notification platform",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-openssl": "*",
        "phpmailer/phpmailer": "^7.2",
        "smalot/pdfparser": "^2.13",
        "vlucas/phpdotenv": "^5.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": { "App\\": "app/" },
        "classmap": ["app/Core/", "app/Services/", "app/Controllers/"],
        "files": ["app/helpers.php"]
    },
    "autoload-dev": {
        "psr-4": { "Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "php bin/lint.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
